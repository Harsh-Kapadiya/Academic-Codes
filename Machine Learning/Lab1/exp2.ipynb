   "source": [
    "# Take input from user\n",
    "text = input(\"Enter text to write into the file: \")\n",
    "\n",
    "# Open file in write mode\n",
    "with open(\"sample.txt\", \"w\") as file:\n",
    "    file.write(text)\n",
    "\n",
    "print(\"Data written successfully.\")"
   ]
  }
